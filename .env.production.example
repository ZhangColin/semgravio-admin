# ========================================
# 管理后台网关 - 生产环境配置模板
# 复制为 .env.production 并填入实际值
# ========================================

# 数据库连接——复用 aiplatform 基础设施 PG 容器（deploy/infra.compose.yml 起的
# aiplatform-postgres，webnet 网络内直连）。首次部署先在该实例上一次性建库：
#   docker exec -it aiplatform-postgres psql -U aiplatform -d aiplatform \
#     -c "CREATE ROLE semgravio LOGIN PASSWORD '<生产密码>'" \
#     -c "CREATE DATABASE semgravio OWNER semgravio"
SPRING_DATASOURCE_URL=jdbc:postgresql://aiplatform-postgres:5432/semgravio
SPRING_DATASOURCE_USERNAME=semgravio
SPRING_DATASOURCE_PASSWORD=your_password

# Redis——复用 aiplatform 基础设施 Redis 容器（aiplatform-redis，同 webnet 网络）
REDIS_HOST=aiplatform-redis
REDIS_PORT=6379

# BFF 签名凭证——与 app-registry 中 admin-console 应用的 apiSecret 同值（固定配置）。
# 取值：app-registry 首次部署/库重建时启动日志打出的
#   "admin-console seed created, apiSecret: ..."（一次性抄录）。
# 两侧同值即签名互通；app-registry 不重建库、不轮换主密钥，此值长期稳定。
ADMIN_API_SECRET=your_admin_console_secret

# 各能力域内网地址（webnet 容器名直连；与 compose 内置默认值一致，特殊拓扑才需覆盖）
APP_REGISTRY_URL=http://semgravio-openapi:8088
AIPLATFORM_SERVICE_URL=http://aiplatform-server:8888
PAYMENT_SERVICE_URL=http://semgravio-payment:8082
IDENTITY_SERVICE_URL=http://semgravio-identity:10001
