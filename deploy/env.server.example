# ========================================
# 管理后台网关 - 生产环境配置模板
# 复制为 .env.production 并填入实际值
# 首装完整步骤见 deploy/部署文档.md（唯一部署正本）
# ========================================
# ⚠ 本模板只是样例：发布/解包绝不覆盖服务器已有 .env.production，
#   既有数据源不会被自动切换（#116）。

# ---- 数据库（PG 数据源三项） ------------------------------------------------
# 首装由 infra 官方幂等建号 helper 创建 semgravio_admin 库 + 同名低权限角色，
# 应用只拿分片凭据（PG 超管密码不出 infra，本仓不复制建库 SQL、不自动建库）：
#   cd <infra 目录>   # aiplatform 部署单元的 deploy/infra/
#   DB_PASSWORD=$(openssl rand -hex 16) ./ensure-db-user.sh semgravio_admin
# 把输出分片抄录到下面三项（幂等：重复执行须带同一个 DB_PASSWORD）。
SPRING_DATASOURCE_URL=jdbc:postgresql://semgravio-pg:5432/semgravio_admin
SPRING_DATASOURCE_USERNAME=semgravio_admin
SPRING_DATASOURCE_PASSWORD=<ensure-db-user.sh 输出的 DB_PASSWORD>

# ---- Redis（主机/端口/密码） -------------------------------------------------
# 共享 infra 契约：容器名 semgravio-redis，已启用 requirepass。
# 密码分片由 infra 运维按 deploy/infra/.env 正本下发（REDIS_PASSWORD 同值），必填无默认。
REDIS_HOST=semgravio-redis
REDIS_PORT=6379
REDIS_PASSWORD=<与 deploy/infra/.env 的 REDIS_PASSWORD 同值>

# ---- BFF 签名凭证 ------------------------------------------------------------
# 与 app-registry 中 admin-console 应用的 apiSecret 同值（固定配置）。
# 取值：app-registry 首次部署/库重建时启动日志打出的
#   "admin-console seed created, apiSecret: ..."（一次性抄录）。
# 两侧同值即签名互通；app-registry 不重建库、不轮换主密钥，此值长期稳定。
ADMIN_API_SECRET=your_admin_console_secret

# ---- 各能力域内网地址（webnet 容器名直连；与 compose 内置默认值一致，特殊拓扑才需覆盖）
# app-registry 部署单元容器名即 semgravio-app-registry（eu-1 现网实测），openapi 签名面直接由它暴露。
APP_REGISTRY_URL=http://semgravio-app-registry:8088
AIPLATFORM_SERVICE_URL=http://aiplatform-server:8888
PAYMENT_SERVICE_URL=http://semgravio-payment:8082
IDENTITY_SERVICE_URL=http://semgravio-identity:10001

# ---- CORS 放行名单（#121） -----------------------------------------------------
# 浏览器管理后台的 Origin（TLS 在共享 nginx 终止，BFF 自见为 http 内网地址，
# 同源请求也带 Origin 走名单比对）。缺此项＝公网登录 403 Invalid CORS request。
# allowCredentials(true) 下禁 *，显式名单逗号分隔；不设则回落 dev 默认源（生产不可用）。
CORS_ALLOWED_ORIGINS=https://admin.semgravio.com
