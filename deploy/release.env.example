# ========================================
# 发布连接参数模板（eu-1 之外的主机也照此复制）
# 复制为 deploy/release.env 并填入实际值；release.sh 启动时自动加载。
# ⚠ release.env 已被 .gitignore 忽略——现网值永不进仓库，别改成别的名字提交。
# SSH_KEY 用 $HOME/ 前缀（不加引号），避免 ~ 在赋值右侧不展开的坑。
# ========================================
SERVER_HOST=1.2.3.4
SERVER_USER=ubuntu
SSH_KEY=$HOME/ssh/your-key.pem
REMOTE_DIR=semgravio-admin
INFRA_DIR=semgravio-infra
